# base_class.py
import os
import json
import logging
from pywinauto import Application, Desktop, keyboard
from pywinauto.timings import wait_until_passes, TimeoutError
from pywinauto.findwindows import ElementNotFoundError

# Logging setup
LOG_DIR = "logs"
os.makedirs(LOG_DIR, exist_ok=True)
logging.basicConfig(
    filename=os.path.join(LOG_DIR, "execution.log"),
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(name)s | %(message)s"
)
logger = logging.getLogger("wja_automation")

class BaseClass:
    def __init__(self):
        with open("config.json", "r") as f:
            self.config = json.load(f)
        self.app = Application(backend=self.config["backend"])
        self.desktop = Desktop(backend=self.config["backend"])
        self.main_window = None

    def launch_application(self):
        logger.info("Launching HP Web Jetadmin application.")
        try:
            self.app.start(self.config["application_path"])
            self.connect_to_main_window()
        except Exception as e:
            logger.error(f"Failed to launch application: {e}")
            raise

    def connect_to_main_window(self):
        logger.info("Connecting to main WJA window.")
        try:
            self.main_window = wait_until_passes(
                timeout=self.config.get("default_timeout", 20),
                retry_interval=1,
                func=lambda: self.desktop.window(title_re=".*HP Web Jetadmin.*"),
                exceptions=(ElementNotFoundError,)
            )
            self.main_window.wait("visible", timeout=self.config.get("default_timeout", 20))
            self.main_window.set_focus()
            logger.info("Main window connected and focused.")
        except Exception as e:
            logger.error(f"Failed to connect to main window: {e}")
            raise

    def wait_for_element(self, parent, **locator):
        logger.info(f"Waiting for element with locator: {locator}")
        try:
            element = wait_until_passes(
                timeout=self.config.get("default_timeout", 20),
                retry_interval=1,
                func=lambda: parent.child_window(**locator).wait("exists enabled visible ready", timeout=5),
                exceptions=(ElementNotFoundError, TimeoutError)
            )
            logger.info("Element found.")
            return parent.child_window(**locator)
        except Exception as e:
            logger.error(f"Element not found: {locator} | Exception: {e}")
            raise

    def click_element(self, parent, **locator):
        logger.info(f"Clicking element: {locator}")
        try:
            element = self.wait_for_element(parent, **locator).wrapper_object()
            element.set_focus()
            element.click_input()
            logger.info("Element clicked.")
        except Exception as e:
            logger.error(f"Failed to click element: {locator} | Exception: {e}")
            raise

    def right_click_element(self, parent, **locator):
        logger.info(f"Right-clicking element: {locator}")
        try:
            element = self.wait_for_element(parent, **locator).wrapper_object()
            element.set_focus()
            element.right_click_input()
            logger.info("Element right-clicked.")
        except Exception as e:
            logger.error(f"Failed to right-click element: {locator} | Exception: {e}")
            raise

    def enter_text(self, parent, text, **locator):
        logger.info(f"Entering text '{text}' into element: {locator}")
        try:
            element = self.wait_for_element(parent, **locator).wrapper_object()
            element.set_focus()
            element.type_keys("^a{BACKSPACE}", set_foreground=True)
            element.type_keys(text, with_spaces=True, set_foreground=True)
            logger.info("Text entered.")
        except Exception as e:
            logger.error(f"Failed to enter text: {locator} | Exception: {e}")
            raise

    def send_keys(self, keys):
        logger.info(f"Sending keys: {keys}")
        try:
            keyboard.send_keys(keys)
        except Exception as e:
            logger.error(f"Failed to send keys: {e}")
            raise

# test.py
import pytest
import allure

from base_class import BaseClass

@allure.feature("Automatic Group Creation")
@pytest.mark.smoke
def test_automatic_group_creation():
    """
    Test Case: Verification of Automatic Group Creation in HP Web Jetadmin
    """
    base = BaseClass()
    base.launch_application()
    base.connect_to_main_window()

    # Step 1: Right click on "Groups" tree item
    nav_tree = base.main_window.child_window(control_type="Tree", found_index=0).wrapper_object()
    groups_item = None
    for item in nav_tree.descendants(control_type="TreeItem"):
        if item.window_text().strip().lower() == "groups":
            groups_item = item
            break
    assert groups_item is not None, "Groups tree item not found"
    groups_item.set_focus()
    groups_item.right_click_input()

    # Step 2: Click "New Group..." button in context menu/toolbar
    # Try context menu first, fallback to toolbar
    try:
        base.send_keys("{DOWN}{ENTER}")
    except Exception:
        # Fallback to toolbar button
        base.click_element(
            base.main_window,
            title="New Group...",
            control_type="Button",
            auto_id="button_create"
        )

    # Step 3: Enter group name in "Create Group - localhost"
    create_group_win = base.desktop.window(title_re="Create Group.*", control_type="Window")
    create_group_win.wait("visible", timeout=base.config["default_timeout"])
    create_group_win.set_focus()
    base.enter_text(
        create_group_win,
        text="WJA",
        auto_id="textBox_newGroupName",
        control_type="Edit"
    )

    # Step 4: Click "Next >" button
    base.click_element(
        create_group_win,
        title="Next >",
        control_type="Button",
        auto_id="btnNext"
    )

    # Step 5: Click "Add..." button on filter criteria page
    base.click_element(
        create_group_win,
        title="Add...",
        control_type="Button",
        auto_id="buttonAdd"
    )

    # Step 6: In "Function - localhost", click "Open" split button to select device property
    function_win = base.desktop.window(title_re="Function.*", control_type="Window")
    function_win.wait("visible", timeout=base.config["default_timeout"])
    function_win.set_focus()
    base.click_element(
        function_win,
        title="Open",
        control_type="SplitButton"
    )

    # Step 7: Select "Device Model" in combo box
    base.click_element(
        function_win,
        control_type="ComboBox"
    )
    # Select the item by value
    combo = function_win.child_window(control_type="ComboBox").wrapper_object()
    for item in combo.descendants(control_type="ListItem"):
        if "Device Model" in item.window_text():
            item.click_input()
            break

    # Step 8: Enter "Hp" in "Value" edit box
    base.enter_text(
        function_win,
        text="Hp",
        control_type="Edit",
        auto_id="1001"
    )

    # Step 9: Click "OK" button
    base.click_element(
        function_win,
        title="OK",
        control_type="Button",
        auto_id="buttonOK"
    )

    # Step 10: Click "Next >" button in "Create Group - localhost"
    create_group_win.set_focus()
    base.click_element(
        create_group_win,
        title="Next >",
        control_type="Button",
        auto_id="btnNext"
    )

    # Step 11: Click "Create Group" button
    base.click_element(
        create_group_win,
        title="Create Group",
        control_type="Button",
        auto_id="btnNext"
    )

    # Step 12: Click "Done" button
    base.click_element(
        create_group_win,
        title="Done",
        control_type="Button",
        auto_id="btnDone"
    )

    # Step 13: Expand "Groups" tree and verify new group
    nav_tree = base.main_window.child_window(control_type="Tree", found_index=0).wrapper_object()
    wja_group = None
    for item in nav_tree.descendants(control_type="TreeItem"):
        if item.window_text().strip().startswith("WJA"):
            wja_group = item
            break
    assert wja_group is not None, "Automatic group 'WJA' not found under Groups tree"
    wja_group.click_input()
    allure.attach("Automatic group 'WJA' created and selected.", name="Group Verification")

    # Step 14: Verify device details are displayed (basic check: window or pane exists)
    device_details_pane = base.main_window.child_window(title_re=".*Device.*", control_type="Pane")
    assert device_details_pane.exists(), "Device details pane not found for the created group"

    logger.info("Automatic group creation test completed successfully.")

