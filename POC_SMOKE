# base_class.py
import json
import time
import logging
import os
from pywinauto import Application, Desktop
from pywinauto.timings import wait_until_passes
from pywinauto.findwindows import ElementNotFoundError
from pywinauto.keyboard import send_keys

# Logging setup (enterprise style)
LOG_DIR = "logs"
os.makedirs(LOG_DIR, exist_ok=True)

def get_logger(name):
    logger = logging.getLogger(name)
    logger.setLevel(logging.INFO)
    if not logger.handlers:
        file_handler = logging.FileHandler(
            os.path.join(LOG_DIR, "execution.log"),
            mode="a",
            encoding="utf-8"
        )
        console_handler = logging.StreamHandler()
        formatter = logging.Formatter(
            "%(asctime)s | %(levelname)s | %(name)s | %(message)s"
        )
        file_handler.setFormatter(formatter)
        console_handler.setFormatter(formatter)
        logger.addHandler(file_handler)
        logger.addHandler(console_handler)
    return logger

log = get_logger(__name__)

class BaseClass:
    def __init__(self):
        with open("config.json") as f:
            self.config = json.load(f)
        self.app = None
        self.desktop = Desktop(backend=self.config["backend"])
        self.main_window = None

    def launch_application(self):
        log.info("Launching HP Web Jetadmin application")
        try:
            self.app = Application(backend=self.config["backend"]).start(self.config["application_path"])
            self.main_window = wait_until_passes(
                timeout=self.config["default_timeout"],
                retry_interval=1,
                func=lambda: self.desktop.window(title_re=".*HP Web Jetadmin.*"),
                exceptions=ElementNotFoundError
            )
            self.main_window.wait("visible", timeout=self.config["default_timeout"])
            self.main_window.set_focus()
            log.info("Main window found and focused")
        except Exception as e:
            log.error(f"Failed to launch or connect to main window: {e}")
            raise

    def connect_to_main_window(self):
        log.info("Connecting to main window")
        try:
            self.main_window = wait_until_passes(
                timeout=self.config["default_timeout"],
                retry_interval=1,
                func=lambda: self.desktop.window(title_re=".*HP Web Jetadmin.*"),
                exceptions=ElementNotFoundError
            )
            self.main_window.wait("visible", timeout=self.config["default_timeout"])
            self.main_window.set_focus()
            log.info("Main window connected and focused")
        except Exception as e:
            log.error(f"Failed to connect to main window: {e}")
            raise

    def wait_for_element(self, parent, **locator):
        log.info(f"Waiting for element: {locator}")
        try:
            return wait_until_passes(
                timeout=self.config["default_timeout"],
                retry_interval=1,
                func=lambda: parent.child_window(**locator).wait("visible", timeout=5),
                exceptions=ElementNotFoundError
            )
        except Exception as e:
            log.error(f"Element not found: {locator} - {e}")
            raise

    def click_element(self, parent, **locator):
        log.info(f"Clicking element: {locator}")
        try:
            element = parent.child_window(**locator).wrapper_object()
            element.set_focus()
            element.click_input()
            log.info(f"Clicked element: {locator}")
        except Exception as e:
            log.error(f"Failed to click element {locator}: {e}")
            raise

    def right_click_element(self, parent, **locator):
        log.info(f"Right-clicking element: {locator}")
        try:
            element = parent.child_window(**locator).wrapper_object()
            element.set_focus()
            element.right_click_input()
            log.info(f"Right-clicked element: {locator}")
        except Exception as e:
            log.error(f"Failed to right-click element: {locator}: {e}")
            raise

    def enter_text(self, parent, text, **locator):
        log.info(f"Entering text '{text}' into element: {locator}")
        try:
            element = parent.child_window(**locator).wrapper_object()
            element.set_focus()
            element.type_keys("^a{BACKSPACE}", set_foreground=True)
            element.type_keys(text, with_spaces=True, set_foreground=True)
            log.info(f"Entered text '{text}' into element: {locator}")
        except Exception as e:
            log.error(f"Failed to enter text in element {locator}: {e}")
            raise

